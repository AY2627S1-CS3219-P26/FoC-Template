# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- User Service -------------------------------------------
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
COOKIE_SECURE=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Message broker (RabbitMQ) ------------------------------
# Docker Compose has a development default for both, so neither has to be set.
# Characters such as @ : / in the password have to be percent-encoded in BROKER_URL.
BROKER_USER=relay
BROKER_PASSWORD=change-me
# Read by every service that publishes or consumes events, when it runs on your machine instead of
# in Compose. Inside Compose it is amqp://<user>:<password>@broker:5672. See docs/events.md.
BROKER_URL=amqp://relay:change-me@localhost:5672

# ---- Supplier Service ---------
# Docker Compose has a development default for each of these, so none has to be set.
SUPPLIER_SERVICE_PORT=3002
# Used by Docker Compose to create the supplier database. Keep them in step with the two URLs below.
SUPPLIER_DB_USER=supplier
SUPPLIER_DB_PASSWORD=change-me
SUPPLIER_DB_NAME=supplier
SUPPLIER_DB_PORT=5433
# Used when the service runs on your machine instead of in Compose.
SUPPLIER_DATABASE_URL=postgres://supplier:change-me@localhost:5433/supplier
# Only for the tests. The database name must end in _test because the tests empty it.
SUPPLIER_TEST_DATABASE_URL=postgres://supplier:change-me@localhost:5433/supplier_test
SUPPLIER_TIMEZONE=Asia/Singapore
SUPPLIER_SEED_ON_STARTUP=true
SUPPLIER_SEED_CSV_PATH=../data/csv/supplier-seed-data.csv
# Seconds a read is served from memory. A session may read for AUTH seconds after it is suspended,
# and a change made by another instance takes up to READ seconds to show. 0 turns a cache off.
SUPPLIER_AUTH_CACHE_SECONDS=5
SUPPLIER_READ_CACHE_SECONDS=2

# ---- Web client ---------------------------------------------
# The web-client container is the gateway for the browser: it forwards /api/<service>/...
# to the services. compose.yaml sets their addresses for the compose network, so nothing
# has to be set here for local use. It reads USER_SERVICE_URL (block below) and one
# <SERVICE>_SERVICE_URL per service with a file in web-client/nginx/templates/routes/.
# A route file and its variable are added together; without the variable nginx refuses to start.
SUPPLIER_SERVICE_URL=http://supplier-service:3002
# The test inbox the verify page links to, as the browser reaches it. Empty where real emails go out.
DEV_MAILBOX_URL=http://localhost:8025

# ---- Read by any service that calls the User Service ----
# Where the user-service is reached from your machine. Inside Compose it is http://user-service:3000.
USER_SERVICE_URL=http://localhost:3001

# ... Add more variables as needed
