#!/bin/bash
# Runs once, on the first boot of the instance: installs k3s as a single-node cluster.
# k3s starts again by itself after every stop and start of the instance.
set -euxo pipefail

# The network can take a moment on the first boot.
until curl -sfL https://get.k3s.io -o /tmp/install-k3s.sh; do sleep 5; done

# --tls-san: the API certificate also covers the public address, so kubectl works from outside.
# --write-kubeconfig-mode: the ubuntu user may read the kubeconfig, so it can be copied over SSH.
INSTALL_K3S_VERSION='${k3s_version}' \
INSTALL_K3S_EXEC='server --tls-san ${public_ip} --write-kubeconfig-mode 0644' \
  sh /tmp/install-k3s.sh
