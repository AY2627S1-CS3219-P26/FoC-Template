# Copy to .env for running the service outside Docker (npm run dev).
# In Docker these values come from compose.yaml.
NODE_ENV=development
ROLE=all
PORT=3006
LOG_LEVEL=debug
USER_SERVICE_URL=http://localhost:3001
FEATURE_STORE=memory
DYNAMODB_TABLE=supplier_stats
AWS_REGION=ap-southeast-1
DYNAMODB_ENDPOINT=
S3_BUCKET=
S3_ENDPOINT=
SCORER_WEIGHTS_TABLE=scorer_weights
BROKER_URL=amqp://relay:change-me@localhost:5672
