# Copy to .env for running the service outside Docker (npm run dev).
# In Docker these values come from compose.yaml.
PORT=3000
LOG_LEVEL=debug
MONGO_URL=mongodb://localhost:27017/user-service
OTP_SECRET=dev-only-otp-secret-do-not-use-in-production
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Relay <no-reply@relay.local>
COOKIE_SECURE=false
ADMIN_EMAIL=admin@nus.edu.sg
ADMIN_PASSWORD=change-me